package com.movieweb.servlet;

import java.io.IOException;
import java.util.List;

import com.movieweb.model.Theaters;
import com.movieweb.model.Users;
import com.movieweb.service.ManagerTheaterRequestService;
import com.movieweb.service.ManagerTheatersService;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;

@WebServlet("/manager-theaters")
public class ManagerTheatersServlet extends HttpServlet {
    private final ManagerTheatersService managerTheatersService = new ManagerTheatersService();
    private final ManagerTheaterRequestService requestService = new ManagerTheaterRequestService();

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        HttpSession session = request.getSession(false);
        Users currentUser = (session == null) ? null : (Users) session.getAttribute("user");
        if (currentUser == null || !"MANAGER".equalsIgnoreCase(currentUser.getRole())) {
            response.sendRedirect(request.getContextPath() + "/main.jsp");
            return;
        }

        String search = request.getParameter("search");
        List<Theaters> theaters = managerTheatersService.getTheatersByManager(
                currentUser.getUserId(), search);

        request.setAttribute("theaters", theaters);
        request.setAttribute("requestableTheaters",
                requestService.getRequestableTheaters(currentUser.getUserId()));
        request.getRequestDispatcher("/manager_theaters.jsp").forward(request, response);
    }
}