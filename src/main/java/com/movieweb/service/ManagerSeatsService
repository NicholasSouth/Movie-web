package com.movieweb.service;

import com.movieweb.DAO.Booking_seatsDAO;
import com.movieweb.DAO.Seat_typesDAO;
import com.movieweb.DAO.SeatsDAO;
import com.movieweb.model.Seats;

import java.util.ArrayList;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Set;
import java.util.regex.Pattern;

public class ManagerSeatsService {
    private static final Pattern SEAT_NAME = Pattern.compile("^[A-Z][1-9][0-9]{0,2}$");
    private static final String NAME_HINT =
            "Invalid seat name. Use one uppercase letter followed by a number, e.g. A1.";

    private final ManagerRoomSeatsService roomSeatsService = new ManagerRoomSeatsService();
    private final SeatsDAO seatsDAO = new SeatsDAO();
    private final Seat_typesDAO seatTypesDAO = new Seat_typesDAO();
    private final Booking_seatsDAO booking_seatsDAO = new Booking_seatsDAO();

    public String addSeat(int managerUserId, int roomId, String seatName, int seatTypeId) {
        if (roomSeatsService.getManagedRoom(managerUserId, roomId) == null) {
            return "Room not found.";
        }
        if (seatName == null || !seatName.matches("^[A-Z][1-9][0-9]{0,2}$")) {
            return "Invalid seat name. Use one uppercase letter followed by a number, e.g. A1.";
        }
        if (seatTypesDAO.getSeatTypeById(seatTypeId) == null) {
            return "Invalid seat type.";
        }

        String row = seatName.substring(0, 1);
        int col = Integer.parseInt(seatName.substring(1));
        if (seatsDAO.seatExists(roomId, row, col)) {
            return "Seat " + seatName + " already exists in this room.";
        }

        Seats seat = new Seats();
        seat.setRoom_id(roomId);
        seat.setSeat_row(row);
        seat.setSeat_col(col);
        seat.setSeat_type_id(seatTypeId);
        return seatsDAO.insertSeat(seat) ? null : "Could not add seat.";
    }

    public String editSeats(int managerUserId, int roomId, String[] seatNames, String newName, int seatTypeId) {
        if (roomSeatsService.getManagedRoom(managerUserId, roomId) == null) {
            return "Room not found.";
        }
        if (seatTypesDAO.getSeatTypeById(seatTypeId) == null) {
            return "Invalid seat type.";
        }

        Set<String> names = new LinkedHashSet<>();
        for (String n : seatNames) {
            String name = n.trim().toUpperCase();
            if (!name.isEmpty()) {
                names.add(name);
            }
        }
        if (names.isEmpty()) {
            return "No seats selected.";
        }

        List<Seats> targets = new ArrayList<>();
        for (String name : names) {
            if (!SEAT_NAME.matcher(name).matches()) {
                return NAME_HINT;
            }
            Seats seat = seatsDAO.getSeatByPosition(roomId, name.substring(0, 1), Integer.parseInt(name.substring(1)));
            if (seat == null) {
                return "Seat " + name + " not found in this room.";
            }
            targets.add(seat);
        }

        String targetName = null;
        if (targets.size() == 1 && newName != null && !newName.trim().isEmpty()) {
            targetName = newName.trim().toUpperCase();
            if (!SEAT_NAME.matcher(targetName).matches()) {
                return NAME_HINT;
            }
        }

        List<Seats> changes = new ArrayList<>();
        List<String> blocked = new ArrayList<>();
        for (Seats seat : targets) {
            String oldRow = seat.getSeat_row().trim();
            int oldCol = seat.getSeat_col();
            String newRow = oldRow;
            int newCol = oldCol;
            if (targetName != null) {
                newRow = targetName.substring(0, 1);
                newCol = Integer.parseInt(targetName.substring(1));
            }

            boolean nameChanged = !newRow.equals(oldRow) || newCol != oldCol;
            boolean typeChanged = seatTypeId != seat.getSeat_type_id();
            if (!nameChanged && !typeChanged) {
                continue; 
            }
            if (nameChanged && seatsDAO.seatExists(roomId, newRow, newCol)) {
                return "Seat " + newRow + newCol + " already exists in this room.";
            }
            if (booking_seatsDAO.hasUpcomingBooking(seat.getSeat_id())) {
                blocked.add(oldRow + oldCol);
                continue;
            }

            Seats updated = new Seats();
            updated.setSeat_id(seat.getSeat_id());
            updated.setRoom_id(roomId);
            updated.setSeat_row(newRow);
            updated.setSeat_col(newCol);
            updated.setSeat_type_id(seatTypeId);
            changes.add(updated);
        }

        if (!blocked.isEmpty()) {
            return "Cannot edit seat" + (blocked.size() > 1 ? "s " : " ") + String.join(", ", blocked)
                    + ": there are bookings for upcoming showtimes.";
        }
        if (changes.isEmpty()) {
            return "No changes to save.";
        }
        return seatsDAO.updateSeats(changes) ? null : "Could not update seats.";
    }

    public String toggleSeats(int managerUserId, int roomId, String[] seatNames, boolean active) {
        if (roomSeatsService.getManagedRoom(managerUserId, roomId) == null) {
            return "Room not found.";
        }

        Set<String> names = normalizeNames(seatNames);
        if (names.isEmpty()) {
            return "No seats selected.";
        }

        List<Integer> seatIds = new ArrayList<>();
        List<String> blocked = new ArrayList<>();
        for (String name : names) {
            if (!SEAT_NAME.matcher(name).matches()) {
                return NAME_HINT;
            }
            Seats seat = seatsDAO.getSeatByPosition(roomId, name.substring(0, 1), Integer.parseInt(name.substring(1)));
            if (seat == null) {
                return "Seat " + name + " not found in this room.";
            }
            if (seat.isActive() == active) {
                continue; 
            }
            if (!active && booking_seatsDAO.hasUpcomingBooking(seat.getSeat_id())) {
                blocked.add(name);
                continue;
            }
            seatIds.add(seat.getSeat_id());
        }

        if (!blocked.isEmpty()) {
            return "Cannot deactivate seat" + (blocked.size() > 1 ? "s " : " ") + String.join(", ", blocked)
                    + ": there are bookings for upcoming showtimes.";
        }
        if (seatIds.isEmpty()) {
            return "No changes to save.";
        }
        return seatsDAO.updateSeatsActive(seatIds, active) ? null : "Could not update seats.";
    }

    public String removeSeats(int managerUserId, int roomId, String[] seatNames) {
        if (roomSeatsService.getManagedRoom(managerUserId, roomId) == null) {
            return "Room not found.";
        }

        Set<String> names = normalizeNames(seatNames);
        if (names.isEmpty()) {
            return "No seats selected.";
        }

        List<Integer> seatIds = new ArrayList<>();
        List<String> blocked = new ArrayList<>();
        for (String name : names) {
            if (!SEAT_NAME.matcher(name).matches()) {
                return NAME_HINT;
            }
            Seats seat = seatsDAO.getSeatByPosition(roomId, name.substring(0, 1), Integer.parseInt(name.substring(1)));
            if (seat == null) {
                return "Seat " + name + " not found in this room.";
            }
            if (booking_seatsDAO.hasUpcomingBooking(seat.getSeat_id())) {
                blocked.add(name);
                continue;
            }
            seatIds.add(seat.getSeat_id());
        }

        if (!blocked.isEmpty()) {
            return "Cannot remove seat" + (blocked.size() > 1 ? "s " : " ") + String.join(", ", blocked)
                    + ": there are bookings for upcoming showtimes.";
        }
        return seatsDAO.deleteSeats(seatIds) ? null : "Could not remove seats.";
    }

    private static Set<String> normalizeNames(String[] raw) {
        Set<String> names = new LinkedHashSet<>();
        for (String n : raw) {
            String name = n.trim().toUpperCase();
            if (!name.isEmpty()) {
                names.add(name);
            }
        }
        return names;
    }
}